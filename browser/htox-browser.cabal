cabal-version: 3.0
name:          htox-browser
synopsis:      hTox in a browser
version:       0.1.0
license:       GPL-3.0-only
build-type:    Simple
author:        iphy
maintainer:    iphy
copyright:     Copyright (c) 2026 The TokTok Team
homepage:      https://toktok.ltd
category:      Network

-- Hatter's browser host runs it as app.wasm (see build.sh).
executable htox
  default-language: Haskell2010
  main-is:          Main.hs
  ghc-options:
    -Wall -no-hs-main -optl-mexec-model=reactor
    -optl-Wl,--export=hs_init,--export=start

  build-depends:
      base            <5
    , hatter-browser
    , htox
